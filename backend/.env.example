# Copia este archivo como ".env" y completa tus datos reales.
# El archivo .env NUNCA se sube al repositorio.

# Puerto del servidor
PORT=3000

# Cadena de conexión de MongoDB Atlas
# (Cluster -> Connect -> Drivers -> copia la URI y reemplaza <db_password> y el nombre de la base)
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/tienda?retryWrites=true&w=majority

# Origen permitido (el de Vite en desarrollo). Varias origins separadas por coma.
CLIENT_ORIGIN=http://localhost:5173
